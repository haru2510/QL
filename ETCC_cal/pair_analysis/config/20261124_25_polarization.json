{
  "_doc": {
    "_": "TPC の飛跡による偏光解析（run_pipeline.py）の設定。相対パスはリポジトリ直下が基準。'_' で始まるキーは説明で、読み込み時に無視する。",
    "name": "解析の名前（表示用）。",
    "output_dir": "結果の保存先。この下に stage0_inputs, stage1_vertices, ... を作る。",
    "beam_axis_fit": "ビーム軸の fit 結果（beam_axis.py の出力 JSON）。全データセットで同じ軸を使う。",
    "run_stages": "--stages を省略したときに実行するステージ。",
    "datasets": "偏光ごとのデータ。etcc_config は raw の場所・較正・散乱点 CSV・Z 側除外の場所を持つ既存の ETCC_cal 設定。runs はその中で使うラン。",
    "samples": "datasets（全ラン）以外に、ランの部分集合を名前付きで定義する（同じ偏光の中での比較などに使う）。",
    "scan": {
      "_": "stage2 で raw を読む範囲。変えると stage2 をやり直す。",
      "beam_radius_mm": "ビーム軸からこの距離以内の散乱点を読む。cut set の beam_radius_mm はこれ以下にする。",
      "radius_mm": "散乱点からこの距離以内のストリップで fit する。",
      "workers": "並列に読むランの数。"
    },
    "cut_sets": {
      "_": "カットの組。base で別の組を継承し、変えるところだけ書ける。stage3〜5 は組ごとに別フォルダに出力する。",
      "z_veto": "true: Z <= z_veto（ETCC 設定）の raw TPC ヒットを持つイベントと、Z <= z_veto の散乱点を除く。false の組が1つでもあると、stage2 は除外にかかったイベントも読む（約3倍、やり直しになる）。",
      "beam_radius_mm": "散乱点とビーム軸の距離の上限。",
      "single_line": "投影が『きれいな1本』の条件: Z 幅 >= min_span_mm、直線に乗ったストリップの割合 >= min_inlier_fraction。",
      "two_branch": "投影が『2本』の条件: 2本の角度差 >= min_separation_deg、各枝の Z 幅 >= min_branch_span_mm（短いと1本の曲がった飛跡を2本に割った偽物が入る）、2本に乗った割合 >= min_inlier_fraction。"
    },
    "analysis": {
      "pair": "対生成の候補（DS・SD・DD）: Q と DD の ψ の比。psi_bins は 0〜90° のビン数。",
      "single_track": "1本の飛跡（SS）: θ >= theta_min_deg ごとの φ の比。phi_bins は 0〜360° のビン数。",
      "overview": "全体図: samples を1枚に重ね、reference に対する比を描く（DD の点だけで fit、DS・SD は参考の点）。"
    },
    "comparisons": "numerator ÷ denominator の比較。分母は偏光の無い円偏光が基本。同じ偏光同士の比較（系統誤差の確認）も入れる。",
    "event_display": "stage5 のイベントの絵。cut_sets を省略すると全部の組で描く。"
  },
