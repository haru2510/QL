# QL に要るファイルだけを管理する。ほかの解析コードやデータは入れない
/*
!/.gitignore
!/README.md
!/ql_sync.sh
!/ql_live.sh

!/TPC_analysis/
/TPC_analysis/*
!/TPC_analysis/check_tpc.py
!/TPC_analysis/ql_tpc.py
!/TPC_analysis/ql_replay.py
!/TPC_analysis/ql_follow.py
!/TPC_analysis/ql_feed.py
!/TPC_analysis/ql_stream.py
!/TPC_analysis/ql_trace.py

!/PSA_analysis/
/PSA_analysis/*
!/PSA_analysis/src_onoda/
/PSA_analysis/src_onoda/*
!/PSA_analysis/src_onoda/ql_psa.py
!/PSA_analysis/src_onoda/psa_decode.py
!/PSA_analysis/src_onoda/check_data.py
!/PSA_analysis/src_onoda/check_ha_order.py
!/PSA_analysis/src_onoda/sub_scr/
/PSA_analysis/src_onoda/sub_scr/*
!/PSA_analysis/src_onoda/sub_scr/get_info.py

# 解析のスクリプト (QL では使わないが、ほかの人に渡すために入れる)
!/PSA_analysis/src_onoda/decode_runs.py
!/PSA_analysis/src_onoda/temp_spectra.py
!/PSA_analysis/src_onoda/peak_search.py
!/PSA_analysis/src_onoda/grid_spect.py
!/PSA_analysis/src_onoda/pixel_id.py
!/PSA_analysis/src_onoda/energy_calib.py
!/PSA_analysis/src_onoda/check_waveform.py
!/PSA_analysis/src_onoda/sub_scr/base_decode.py
!/PSA_analysis/src_onoda/sub_scr/h5_io.py
!/PSA_analysis/src_onoda/sub_scr/read_temp.py
!/PSA_analysis/src_onoda/sub_scr/send_rbcp_cmd.py

# 解析が既定で読むパラメータ (HA の SN・HV・温度の較正、run の設定)
!/PSA_analysis/param/
/PSA_analysis/param/*
!/PSA_analysis/param/psa_param_20261029.csv
!/PSA_analysis/param/psa_param.csv
!/PSA_analysis/param/run_file.json

# 最初にもらった元のコード (src_onoda はここから直したもの。比べるために残す)
!/PSA_analysis/original/
